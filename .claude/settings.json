{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status --short)",
      "Bash(git diff --check)",
      "Bash(./mvnw --batch-mode --no-transfer-progress test)",
      "Bash(./mvnw --batch-mode --no-transfer-progress clean verify)",
      "Bash(./scripts/release-preflight.sh)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(docker system prune *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(sed *)",
      "Bash(docker compose config)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./backend/.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.development.local)",
      "Read(./.env.test.local)",
      "Read(./backend/.env.local)",
      "Read(./backend/.env.production)",
      "Read(./backend/.env.production.local)",
      "Read(./backend/.env.development.local)",
      "Read(./backend/.env.test.local)",
      "Read(./project.private.config.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/secrets/**)",
      "Read(./**/*credentials*.json)",
      "Read(./**/*secret*.json)",
      "Edit(./.env)",
      "Edit(./backend/.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./.env.production.local)",
      "Edit(./.env.development.local)",
      "Edit(./.env.test.local)",
      "Edit(./backend/.env.local)",
      "Edit(./backend/.env.production)",
      "Edit(./backend/.env.production.local)",
      "Edit(./backend/.env.development.local)",
      "Edit(./backend/.env.test.local)",
      "Edit(./project.private.config.json)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Edit(./**/*.p12)",
      "Edit(./**/secrets/**)",
      "Edit(./**/*credentials*.json)",
      "Edit(./**/*secret*.json)"
    ]
  }
}
