# Local development values for `docker compose --profile app up`.
# Production uses separate secrets and role-specific accounts below.
DB_URL=jdbc:mysql://localhost:3306/demeter?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC&sslMode=DISABLED
DB_USERNAME=demeter_api
DB_PASSWORD=local-api-password-change-me
DB_API_PASSWORD=local-api-password-change-me
DB_WORKER_PASSWORD=local-worker-password-change-me
DB_MAINTENANCE_PASSWORD=local-maintenance-password-change-me
DB_MIGRATOR_PASSWORD=local-migrator-password-change-me
FLYWAY_ENABLED=false
MYSQL_ROOT_PASSWORD=change-root-password
WECHAT_APP_ID=replace-with-production-app-id
WECHAT_APP_SECRET=replace-with-production-app-secret
MANAGEMENT_ACCESS_TOKEN=replace-with-at-least-32-random-characters
MANAGEMENT_PORT=9090
MANAGEMENT_ADDRESS=127.0.0.1
TRUSTED_PROXY_PATTERN=10\\..*|172\\.(1[6-9]|2[0-9]|3[0-1])\\..*|192\\.168\\..*
APP_REPLICA_COUNT=1
GATEWAY_RATE_LIMIT_ENABLED=false
DEMETER_RUNTIME_ROLE=API
AUTH_SESSION_TTL=30d
OCR_STORAGE_PATH=./data/ocr
OCR_STORAGE_SHARED=false
OCR_WORKER_ENABLED=false
# Set OCR_QWEN_ENABLED=true only on the OCR Worker after provisioning an API key.
# The API key must be for the same DashScope region as DASHSCOPE_CHAT_COMPLETIONS_URL.
OCR_QWEN_ENABLED=false
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
# For production, use the workspace-specific HTTPS endpoint recommended by Model Studio.
DASHSCOPE_CHAT_COMPLETIONS_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
OCR_QWEN_MODEL=qwen3-vl-plus
OCR_LEASE_DURATION=2m
OCR_RETRY_DELAY=30s
OCR_MAX_RETRY_DELAY=15m
OCR_MAX_ATTEMPTS=3
OCR_DOCUMENT_RETENTION=30d
OCR_STORAGE_ORPHAN_GRACE_PERIOD=2h
OCR_STORAGE_ORPHAN_SCAN_LIMIT=1000
MAINTENANCE_ENABLED=false
PAYMENT_RECONCILIATION_ENABLED=false
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Optional server-rendered admin console (disabled by default)
ADMIN_ENABLED=false
ADMIN_ACCESS_TOKEN=
ADMIN_SESSION_TTL=8h
