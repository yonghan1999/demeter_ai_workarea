# Production template. Do not use this file as a secret store.
# Load real values from the approved secret manager or deployment platform.

# Shared
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://mysql.example.internal:3306/demeter?sslMode=VERIFY_IDENTITY&connectionTimeZone=UTC
FLYWAY_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
DATABASE_MINIMUM_SCHEMA_VERSION=23
MANAGEMENT_ACCESS_TOKEN=replace-with-at-least-32-random-characters
MANAGEMENT_PORT=9090
# Keep the management server private. Do not bind it to 0.0.0.0.
MANAGEMENT_ADDRESS=127.0.0.1
OCR_STORAGE_PATH=/var/lib/demeter/ocr
OCR_STORAGE_SHARED=true
OCR_FILESYSTEM_ENABLED=false
APP_REPLICA_COUNT=2
GATEWAY_RATE_LIMIT_ENABLED=true
TRUSTED_PROXY_PATTERN=10\\..*|172\\.(1[6-9]|2[0-9]|3[0-1])\\..*|192\\.168\\..*
TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otel-collector.example.internal/v1/traces

# Runtime roles are exclusive. Do not enable API, Worker, and Maintenance
# background duties in the same production process.

# API role
DEMETER_RUNTIME_ROLE=API
DB_USERNAME=demeter_api
DB_PASSWORD=replace-with-api-db-password
WECHAT_APP_ID=replace-with-production-wechat-app-id
WECHAT_APP_SECRET=replace-with-production-wechat-secret
SERVER_ADDRESS=0.0.0.0
OCR_WORKER_ENABLED=false
MAINTENANCE_ENABLED=false
PAYMENT_RECONCILIATION_ENABLED=false

# Worker role overrides
# DEMETER_RUNTIME_ROLE=WORKER
# DB_USERNAME=demeter_worker
# DB_PASSWORD=replace-with-worker-db-password
# SERVER_ADDRESS=127.0.0.1
# OCR_WORKER_ENABLED=true
# MAINTENANCE_ENABLED=false
# PAYMENT_RECONCILIATION_ENABLED=false
# OCR_PROVIDER_TIMEOUT=20s
# OCR_QWEN_ENABLED=true
# DASHSCOPE_API_KEY=inject-from-secret-manager
# DASHSCOPE_CHAT_COMPLETIONS_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
# OCR_QWEN_MODEL=qwen3-vl-plus
# OCR_LEASE_DURATION=2m

# Maintenance role overrides
# DEMETER_RUNTIME_ROLE=MAINTENANCE
# DB_USERNAME=demeter_maintenance
# DB_PASSWORD=replace-with-maintenance-db-password
# SERVER_ADDRESS=127.0.0.1
# OCR_WORKER_ENABLED=false
# MAINTENANCE_ENABLED=true
# PAYMENT_RECONCILIATION_ENABLED=true

# Migrator role. Use only for the dedicated migration job.
# MIGRATION_DB_URL=jdbc:mysql://mysql.example.internal:3306/demeter?sslMode=VERIFY_IDENTITY&connectionTimeZone=UTC
# MIGRATION_DB_USERNAME=demeter_migrator
# MIGRATION_DB_PASSWORD=replace-with-migrator-db-password
