.bottom-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: flex-end;
  background: rgba(14, 24, 42, 0.42);
}

.bottom-sheet {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 90vh;
  border-radius: 34rpx 34rpx 0 0;
  background: #edf0f6;
  padding: 0 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
}

.bottom-sheet-handle {
  align-self: center;
  width: 54rpx;
  height: 6rpx;
  margin: 14rpx 0 4rpx;
  border-radius: 3rpx;
  background: #d5dce7;
}

.bottom-sheet-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: none;
  min-height: 148rpx;
  margin: 0 -32rpx;
  background: #ffffff;
  padding: 22rpx 32rpx;
  box-sizing: border-box;
}

.bottom-sheet-title {
  color: #17213a;
  font-size: 31rpx;
  font-weight: 800;
}

.bottom-sheet-subtitle {
  display: block;
  margin-top: 4rpx;
  color: #8c9bae;
  font-size: 20rpx;
}

.bottom-sheet-close {
  position: absolute;
  top: 22rpx;
  right: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #f2f4f8;
  padding: 0;
}

.bottom-sheet-close image {
  width: 34rpx;
  height: 34rpx;
}
