.bill-export-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 0;
  padding-bottom: 0;
  background: #edf0f6;
}

.preview-scroll {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.preview-intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 58rpx;
  color: #718198;
  font-size: 22rpx;
  font-weight: 700;
}

.preview-intro > view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.preview-note {
  color: #8c9bae;
  font-size: 18rpx;
  font-weight: 500;
}

.ui-button.preview-zoom {
  height: 64rpx;
  margin: 4rpx 0 18rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: #315aaf;
  font-size: 22rpx;
  line-height: 64rpx;
}

.preview-page {
  margin-bottom: 24rpx;
  border-radius: 10rpx;
  background: #ffffff;
  padding: 8rpx;
  box-shadow: 0 5rpx 18rpx rgba(17, 32, 80, 0.1);
}

.preview-page-scroll {
  width: 100%;
}

.preview-page-scroll image {
  display: block;
  width: 100%;
}

.preview-page-scroll.zoomed image {
  width: 160%;
}

.preview-page text {
  display: block;
  padding: 10rpx 8rpx 4rpx;
  color: #8c9bae;
  font-size: 19rpx;
  text-align: right;
}

.preview-bottom {
  flex: none;
  border-top: 1rpx solid #e2e7ef;
  background: rgba(255, 255, 255, 0.97);
  padding: 18rpx 32rpx;
  box-shadow: 0 -8rpx 28rpx rgba(17, 32, 80, 0.08);
}

.share-message {
  display: block;
  margin-bottom: 12rpx;
  color: #315aaf;
  font-size: 21rpx;
  text-align: center;
}

.share-failure-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(23, 33, 58, 0.42);
  padding: 32rpx;
}

.share-failure-card {
  width: 100%;
  border-radius: 28rpx;
  background: #ffffff;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.share-failure-title {
  color: #17213a;
  font-size: 31rpx;
  font-weight: 800;
}

.share-failure-card > text {
  display: block;
  margin-top: 20rpx;
  color: #61738f;
  font-size: 22rpx;
  line-height: 34rpx;
}

.ui-button.share-retry,
.ui-button.share-return {
  width: 100%;
  height: 84rpx;
  margin-top: 28rpx;
  border-radius: 24rpx;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.ui-button.share-retry {
  background: #174fc4;
  color: #ffffff;
}

.ui-button.share-return {
  margin-top: 16rpx;
  border: 2rpx solid #174fc4;
  background: #ffffff;
  color: #174fc4;
  line-height: 80rpx;
}

.ui-button.share-button {
  width: 100%;
  height: 84rpx;
  border-radius: 26rpx;
  background: #174fc4;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.ui-button.share-button[disabled] {
  background: #9aadd8;
}

.export-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 160rpx);
  padding: 40rpx;
  color: #8c9bae;
  font-size: 23rpx;
  text-align: center;
}

.export-state-title {
  margin-bottom: 14rpx;
  color: #17213a;
  font-size: 31rpx;
  font-weight: 800;
}

.state-spinner {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 26rpx;
  border: 6rpx solid #dce3ee;
  border-top-color: #174fc4;
  border-radius: 50%;
  animation: bill-export-spin 0.8s linear infinite;
}

.ui-button.secondary-button {
  height: 76rpx;
  margin-top: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  padding: 0 36rpx;
  color: #315aaf;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.render-canvas {
  position: fixed;
  top: -2000px;
  left: -2000px;
  width: 1684px;
  height: 1190px;
  opacity: 0;
  pointer-events: none;
}

@keyframes bill-export-spin {
  to {
    transform: rotate(360deg);
  }
}
