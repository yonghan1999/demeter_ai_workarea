<view class="page form-page">
  <app-nav title="{{title}}" nav-style="{{systemLayout.navStyle || ''}}" bind:back="back" />

  <view wx:if="{{ready}}" class="form-content">
    <view wx:if="{{errorSummary}}" class="form-error-summary">{{errorSummary}}</view>
    <view class="bill-code mono">{{billCodeDisplay}}</view>

    <view class="form-card amount-card {{errors.amount ? 'field-error-card' : ''}}" bindtap="focusAmount">
      <view class="form-label">账单金额</view>
      <view class="amount-input-row">
        <text>¥</text>
        <input
          id="bill-amount-input"
          class="amount-input mono"
          type="digit"
          inputmode="decimal"
          data-field="amount"
          value="{{form.amount}}"
          focus="{{amountFocused}}"
          adjust-position="{{true}}"
          cursor-spacing="32"
          confirm-type="done"
          placeholder="0.00"
          placeholder-style="color:#17213a"
          maxlength="12"
          bindfocus="onAmountFocus"
          bindblur="onAmountBlur"
          bindinput="setField"
        />
      </view>
    </view>

    <view class="form-card status-card">
      <view class="form-label">支付状态</view>
      <view class="status-toggle">
        <button class="status-button {{unpaidClass}}" data-status="unpaid" bindtap="setStatus"><text>未收款</text></button>
        <button class="status-button {{paidClass}}" data-status="paid" bindtap="setStatus"><text>已收款</text></button>
      </view>
    </view>

    <view class="form-card form-section">
      <view class="form-label section-label">托运信息</view>
      <view class="form-field shipper-field">
        <view class="field-label">托运人</view>
        <view class="input-shell {{errors.shipper ? 'field-error-shell' : ''}}" data-mode="shipper" bindtap="openSuggestionSheet"><image class="field-icon" src="/assets/icons/person.svg" mode="aspectFit" /><text class="field-value {{form.shipper ? '' : 'field-placeholder'}}">{{form.shipper || '请选择或输入托运人'}}</text></view>
      </view>
      <view class="form-field">
        <view class="field-label">车型</view>
        <view class="input-shell"><image class="field-icon" src="/assets/icons/truck.svg" mode="aspectFit" /><input class="field-input" data-field="vehicleCargo" value="{{form.vehicleCargo}}" placeholder="请输入车型" maxlength="40" bindinput="setField" /></view>
      </view>
      <view class="form-field">
        <view class="field-label">日期</view>
        <picker mode="date" value="{{form.date}}" bindchange="setDate"><view class="input-shell date-field {{errors.date ? 'field-error-shell' : ''}}"><image class="field-icon" src="/assets/icons/calendar.svg" mode="aspectFit" /><text class="mono">{{form.date || '请选择运输日期'}}</text></view></picker>
      </view>
    </view>

    <view class="form-card form-section route-section">
      <view class="form-label section-label">运输路线</view>
      <view class="form-field">
        <view class="field-label">始发地</view>
        <view class="input-shell {{errors.from ? 'field-error-shell' : ''}}" data-mode="from" bindtap="openSuggestionSheet"><image class="field-icon" src="/assets/icons/location.svg" mode="aspectFit" /><text class="field-value {{form.from ? '' : 'field-placeholder'}}">{{form.from || '请选择始发地'}}</text></view>
      </view>
      <view class="route-divider"><view class="route-line"></view><text class="route-copy">↓ 发往</text><view class="route-line"></view></view>
      <view class="form-field">
        <view class="field-label">目的地</view>
        <view class="input-shell {{errors.to ? 'field-error-shell' : ''}}" data-mode="to" bindtap="openSuggestionSheet"><image class="field-icon" src="/assets/icons/location.svg" mode="aspectFit" /><text class="field-value {{form.to ? '' : 'field-placeholder'}}">{{form.to || '请选择目的地'}}</text></view>
      </view>
    </view>
  </view>

  <view wx:if="{{suggestionOpen}}" class="form-sheet-mask" bindtap="closeSuggestionSheet">
    <view class="form-sheet" style="{{systemLayout.bottomSafeStyle}}" catchtap="stopPropagation">
      <view class="form-sheet-handle"></view>
      <view class="form-sheet-header">
        <view class="form-sheet-title">{{suggestionTitle}}</view>
        <button class="form-sheet-close" bindtap="closeSuggestionSheet"><image src="/assets/icons/close.svg" mode="aspectFit" /></button>
      </view>
      <view class="form-sheet-search">
        <image src="/assets/icons/search.svg" mode="aspectFit" />
        <input class="form-sheet-search-input" value="{{suggestionQuery}}" focus placeholder="{{suggestionPlaceholder}}" bindinput="setSuggestionQuery" bindconfirm="onSuggestionConfirm" confirm-type="done" />
        <button class="form-sheet-confirm" bindtap="onSuggestionConfirm" disabled="{{!suggestionQuery}}">确认</button>
      </view>
      <view class="form-sheet-caption">{{suggestionCaption}}</view>
      <scroll-view class="form-sheet-list" scroll-y>
        <button wx:for="{{suggestionItems}}" wx:key="id" class="form-sheet-item" data-value="{{item.value}}" bindtap="chooseFormSuggestion">
          <view>{{item.label}}</view>
          <text>{{item.meta}}</text>
        </button>
        <view wx:if="{{suggestionItems.length === 0 && !suggestionQuery}}" class="form-sheet-empty">暂无匹配项</view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="form-state"><view class="state-spinner"></view><text>正在加载账单</text></view>
  <view wx:if="{{loadFailed}}" class="form-state"><view class="form-state-title">账单加载失败</view><text>请检查后重试</text><view class="form-state-actions"><button bindtap="retryLoad">重试</button><button class="secondary" bindtap="back">返回</button></view></view>

  <view wx:if="{{ready}}" class="form-bottom"><button class="primary-button {{saveDisabledClass}}" disabled="{{submitting}}" bindtap="save">{{saveText}}</button></view>
</view>

