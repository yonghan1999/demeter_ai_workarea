<view class="page filter-page">
  <view class="filter-nav" style="{{systemLayout.navStyle}}">
    <button class="filter-back" bindtap="back"><image src="/assets/icons/back.svg" mode="aspectFit" /></button>
    <view class="filter-title">高级筛选</view>
  </view>
  <view class="filter-content">
    <view class="filter-toolbar">
      <text>筛选条件</text>
      <button class="filter-reset" bindtap="reset">重置</button>
    </view>
    <view class="filter-card info-card">
      <view class="filter-label section-label">账单信息</view>
      <view class="filter-field"><view class="filter-label">托运人</view><view class="filter-input-shell"><image src="/assets/icons/person.svg" mode="aspectFit" /><input class="filter-input" data-field="shipper" value="{{form.shipper}}" placeholder="托运单位或个人姓名" maxlength="60" bindinput="setField" /></view></view>
      <view class="filter-field"><view class="filter-label">出发地</view><view class="filter-input-shell"><image src="/assets/icons/location.svg" mode="aspectFit" /><input class="filter-input" data-field="from" value="{{form.from}}" placeholder="输入出发城市" maxlength="40" bindinput="setField" /></view></view>
      <view class="filter-field"><view class="filter-label">目的地</view><view class="filter-input-shell"><image src="/assets/icons/location.svg" mode="aspectFit" /><input class="filter-input" data-field="to" value="{{form.to}}" placeholder="输入目的城市" maxlength="40" bindinput="setField" /></view></view>
    </view>
    <view class="filter-card">
      <view class="filter-label">支付状态</view>
      <view class="segmented"><button wx:for="{{statusOptions}}" wx:key="key" data-status="{{item.key}}" class="status-option {{item.className}}" bindtap="setStatus">{{item.text}}</button></view>
    </view>
  </view>
  <view class="filter-bottom"><button class="primary-button" bindtap="submit"><image src="/assets/icons/filter.svg" mode="aspectFit" />确定筛选</button></view>
</view>
