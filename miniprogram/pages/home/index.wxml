<view class="page home-page">
  <app-nav title="货运账单" nav-style="{{systemLayout.navStyle || ''}}" show-back="{{false}}" />

  <view class="home-controls">
    <view class="search-card {{batchMode ? 'control-disabled' : ''}}" bindtap="openSearch">
      <image class="search-icon" src="/assets/icons/search.svg" mode="aspectFit" />
      <text>搜索托运人、单号或路线</text>
    </view>

    <scroll-view class="quick-tools-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="quick-tools">
        <view class="quick-tool camera-tool primary {{batchMode ? 'control-disabled' : ''}}" bindtap="goCamera"><image class="quick-tool-icon" src="/assets/icons/camera.svg" mode="aspectFit" /><text>拍照识别</text></view>
        <view class="quick-tool {{batchMode ? 'control-disabled' : ''}}" bindtap="goOcrTasks">
          <image class="quick-tool-icon" src="/assets/icons/sparkles.svg" mode="aspectFit" /><text>识别任务</text>
          <text wx:if="{{pendingOcr + unmergedOcr > 0}}" class="quick-badge">{{pendingOcr + unmergedOcr}}</text>
        </view>
        <view class="quick-tool batch-tool {{batchMode ? 'managing' : ''}}" bindtap="goSelect"><image class="quick-tool-icon" src="/assets/icons/sliders.svg" mode="aspectFit" /><text>{{batchMode ? '退出管理' : '批量管理'}}</text></view>
        <view class="quick-tool filter-tool {{filterCount > 0 ? 'filtered' : ''}} {{batchMode ? 'control-disabled' : ''}}" bindtap="goFilter"><image class="quick-tool-icon" src="/assets/icons/filter.svg" mode="aspectFit" /><text>高级筛选</text><text wx:if="{{filterCount > 0}}" class="filter-badge">{{filterCount}}</text></view>
      </view>
    </scroll-view>

    <view class="tabs">
      <view wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" class="tab {{item.className}}" bindtap="onTabTap">{{item.text}}</view>
    </view>
  </view>

  <view class="list-meta {{batchMode ? 'batch-list-meta' : ''}}">
    <block wx:if="{{initialLoading}}"><text>正在加载</text></block>
    <block wx:elif="{{loadFailed}}"><text>加载失败</text></block>
    <block wx:elif="{{batchMode}}">
      <text><text class="selected-count">{{selectedIds.length}}</text> / {{total}} 笔已选</text>
      <view class="select-all" role="button" bindtap="toggleAll">{{allSelected ? '取消全选' : '全选'}}</view>
    </block>
    <block wx:else>
      <view class="result-count"><text>{{total}} 条账单</text><button wx:if="{{filterCount > 0}}" class="filter-summary" bindtap="clearAdvancedFilters">已筛选 · 清除</button></view>
      <text class="swipe-hint">← 左滑标记 / 删除</text>
    </block>
  </view>

  <view wx:if="{{bills.length > 0}}" class="bill-list">
    <view wx:if="{{batchMode && hasActiveFilter}}" class="applied-filter-summary">
      <text>当前列表：{{activeFilterSummary}} · {{total}} 条账单</text>
      <text>已筛选</text>
    </view>
    <view wx:for="{{bills}}" wx:key="id" wx:for-index="index" class="swipe-wrap">
      <view wx:if="{{!batchMode}}" class="swipe-actions">
        <button class="action paid-action" data-id="{{item.id}}" bindtap="markPaid"><image class="action-icon" src="/assets/icons/check.svg" mode="aspectFit" /><text>已收款</text></button>
        <button class="action delete-action" data-id="{{item.id}}" bindtap="deleteBill"><image class="action-icon" src="/assets/icons/trash.svg" mode="aspectFit" /><text>删除</text></button>
      </view>
      <view
        class="card-front"
        data-index="{{index}}"
        style="transform: translateX({{batchMode ? 0 : item.offset}}px);"
        bindtouchstart="onTouchStart"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
        bindtouchcancel="onTouchEnd"
      >
        <bill-card bill="{{item}}" selectable="{{batchMode}}" selected="{{item.selected}}" bind:tapbill="handleBillTap" />
      </view>
    </view>
  </view>

  <view wx:if="{{initialLoading}}" class="home-state" aria-label="正在加载账单">
    <view class="home-state-title">正在加载账单</view>
    <text>正在同步最新账单数据</text>
  </view>

  <view wx:if="{{loadFailed}}" class="home-state">
    <view class="home-state-title">账单加载失败</view>
    <text>网络异常，请检查后重试</text>
    <button class="home-state-button" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:if="{{!loading && !loadFailed && bills.length === 0}}" class="home-state">
    <view class="home-state-title">{{filterCount > 0 || activeStatus !== 'all' ? '暂无符合条件的账单' : '还没有账单'}}</view>
    <text>{{filterCount > 0 || activeStatus !== 'all' ? '可以调整或清除当前筛选条件' : '手动新增账单，或拍照识别手写账本'}}</text>
    <button wx:if="{{filterCount > 0}}" class="home-state-button" bindtap="clearAdvancedFilters">清除高级筛选</button>
    <button wx:else class="home-state-button" bindtap="goCreate">新增账单</button>
  </view>

  <view wx:if="{{dialOpen}}" class="fab-mask" bindtap="closeOverlays"></view>
  <view wx:if="{{!batchMode && !filterOpen}}" class="fab-group">
    <view wx:if="{{dialOpen}}" class="fab-options">
      <button class="fab-option" bindtap="goCamera">
        <text class="fab-small-icon">拍</text>
        <text>拍照识别</text>
      </button>
      <button class="fab-option" bindtap="goCreate">
        <text class="fab-small-icon muted">+</text>
        <text>手动新增</text>
      </button>
    </view>
    <button class="fab" bindtap="toggleDial">+</button>
  </view>

  <view wx:if="{{batchMode}}" class="batch-bottom" style="{{systemLayout.bottomSafeStyle}}">
    <view class="batch-total">
      <text>已选 {{selectedIds.length}} 笔合计</text>
      <view class="mono">{{selectedAmount}}</view>
    </view>
    <button class="batch-delete {{selectedIds.length === 0 || deleting ? 'disabled' : ''}}" disabled="{{selectedIds.length === 0 || deleting}}" bindtap="deleteSelected">
      <image class="batch-delete-icon" src="/assets/icons/trash.svg" mode="aspectFit" />
      <text>{{deleteText}}</text>
    </button>
  </view>

  <view wx:if="{{deleteConfirmation}}" class="delete-confirm-mask" bindtap="cancelDelete">
    <view class="delete-confirm-dialog" catchtap="stopPropagation">
      <view class="delete-confirm-title">确认删除 {{deleteConfirmation.count}} 笔账单？</view>
      <text>删除后无法恢复，请确认所选账单无误。</text>
      <view class="delete-confirm-actions">
        <button bindtap="cancelDelete"><text>取消</text></button>
        <button class="danger" bindtap="confirmDelete"><text>{{deleting ? '正在删除' : '确认删除'}}</text></button>
      </view>
    </view>
  </view>

  <bottom-sheet visible="{{filterOpen}}" title="高级筛选" subtitle="筛选当前账单列表" safe-style="{{systemLayout.bottomSafeStyle}}" bind:close="closeFilter">

      <view class="filter-sheet-body">
        <view class="inline-filter-toolbar"><text>筛选条件</text><button class="inline-filter-reset" bindtap="resetFilterDraft">重置</button></view>
        <view class="inline-filter-card">
          <view class="inline-filter-label">订单号</view>
          <view class="inline-filter-input"><text>#</text><input class="inline-filter-input-field" data-field="code" value="{{filterDraft.code}}" placeholder="输入订单编号" bindinput="setFilterField" /></view>
          <view class="inline-filter-label second">托运人</view>
          <view class="inline-filter-input"><image class="inline-filter-input-icon" src="/assets/icons/person.svg" mode="aspectFit" /><input class="inline-filter-input-field" data-field="shipper" value="{{filterDraft.shipper}}" placeholder="托运单位或个人姓名" maxlength="60" bindinput="setFilterField" /></view>
        </view>
        <view class="inline-filter-card">
          <view class="inline-filter-label">支付状态</view>
          <status-segmented variant="inline" options="{{filterStatusOptions}}" value="{{filterDraft.status}}" bind:change="setFilterStatus" />
        </view>
        <view class="inline-filter-card date-range-card">
          <view class="inline-filter-label">运输日期</view>
          <view class="date-range-row">
            <picker class="date-range-picker" mode="date" value="{{filterDraft.startDate}}" data-field="startDate" end="{{filterDraft.endDate || '2100-12-31'}}" bindchange="setFilterDate">
              <view class="date-range-value {{filterDraft.startDate ? '' : 'placeholder'}}"><text>{{filterDraft.startDate || '开始日期'}}</text></view>
            </picker>
            <text class="date-range-separator">至</text>
            <picker class="date-range-picker" mode="date" value="{{filterDraft.endDate}}" data-field="endDate" start="{{filterDraft.startDate || '2000-01-01'}}" bindchange="setFilterDate">
              <view class="date-range-value {{filterDraft.endDate ? '' : 'placeholder'}}"><text>{{filterDraft.endDate || '结束日期'}}</text></view>
            </picker>
          </view>
          <view wx:if="{{filterError}}" class="filter-error">{{filterError}}</view>
        </view>
      </view>

      <button class="apply-filter" bindtap="applyFilter"><image class="apply-filter-icon" src="/assets/icons/filter.svg" mode="aspectFit" /><text>查看筛选结果</text></button>
  </bottom-sheet>
</view>
