<view class="page tasks-page">
  <app-nav title="识别任务" nav-style="{{systemLayout.navStyle || ''}}" bind:back="back" />
  <view class="tasks-list">
    <view class="tasks-section-title">最近任务</view>
    <view wx:if="{{loading}}" class="tasks-skeleton"><view class="task-card skeleton-card"><view class="skeleton-thumb"></view><view class="skeleton-copy"><view></view><view></view><view></view></view></view></view>
    <state-panel wx:elif="{{loadFailed}}" title="任务加载失败" subtitle="请检查网络后重试" action-text="重新加载" bind:action="retryLoad" />
    <block wx:else>
    <view wx:for="{{tasks}}" wx:key="id" class="task-entry task-entry-{{item.status}}">
    <view class="task-card task-{{item.status}}" data-id="{{item.id}}" bindtap="review">
      <view class="task-head">
        <view class="task-image"><image src="/assets/icons/image.svg" mode="aspectFit" /></view>
        <view class="task-head-copy"><view class="task-status {{item.status}} {{item.mergedClass}}">{{item.statusPrefix}}{{item.statusText}}</view><view class="task-time">{{item.timeText}}</view></view>
      </view>
      <block wx:if="{{item.isCompleted}}">
        <view class="task-divider"></view>
        <view class="task-result">
          <view class="result-summary"><view><view>识别到 <text class="result-count">{{item.bills.length}}</text> 笔账单</view><text class="result-total">合计 {{item.previewTotal}}</text></view><button class="view-button"><text>{{item.merged ? '查看账单' : '查看结果'}}</text><text class="view-button-arrow">›</text></button></view>
          <view wx:for="{{item.previewBills}}" wx:key="id" class="preview-row"><text class="preview-shipper">{{item.shipper}}</text><text class="confidence {{item.confidenceClass}}">可信度{{item.confidenceLevel}} {{item.confidencePercent}}%</text><text class="preview-amount mono">{{item.amountText}}</text></view>
          <view wx:if="{{item.moreCount > 0}}" class="more-count">+ {{item.moreCount}} 笔更多</view>
        </view>
      </block>
      <view wx:elif="{{item.isProcessing}}" class="processing"><view class="progress"><view class="progress-inner"></view></view><text>正在识别账单字段</text></view>
      <view wx:elif="{{item.isFailed}}" class="processing failed-processing"><view class="progress"><view class="progress-inner"></view></view><text>{{item.failureText}}</text></view>
    </view>
    <button wx:if="{{item.isFailed}}" class="retry-task-outside" data-id="{{item.id}}" bindtap="retryTask">{{retryingId === item.id ? '正在重试' : '重新识别'}}</button>
    </view>
    <state-panel wx:if="{{!loading && tasks.length === 0}}" title="还没有识别任务" subtitle="拍摄手写账本即可开始识别" action-text="拍照识别" bind:action="newCapture" />
    </block>
  </view>
  <bottom-action-bar variant="tasks" safe-style="{{systemLayout.bottomSafeStyle}}"><button class="primary-button" bindtap="newCapture">拍照新建识别任务</button></bottom-action-bar>
</view>
