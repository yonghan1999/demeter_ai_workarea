.profile-page { min-height: 100vh; background: #f8f9fb; }
.profile-content { padding: 32rpx; }
.profile-description, .profile-state { color: #64748b; font-size: 26rpx; line-height: 42rpx; margin-bottom: 28rpx; }
.profile-card { padding: 28rpx; border-radius: 20rpx; background: #ffffff; }
.profile-label { display: block; color: #17213a; font-size: 28rpx; font-weight: 600; margin-bottom: 20rpx; }
.profile-card input { height: 88rpx; padding: 0 20rpx; border: 2rpx solid #e2e8f0; border-radius: 12rpx; font-size: 30rpx; }
.profile-error { color: #cc1d25; font-size: 26rpx; line-height: 40rpx; margin-top: 24rpx; }
.ui-button.profile-save { width: 100%; min-height: 88rpx; margin-top: 32rpx; border-radius: 16rpx; background: #174fc4; color: #ffffff; font-size: 30rpx; }
.ui-button.profile-save[disabled] { opacity: 0.5; }
