.filter-page { min-height: 100vh; padding-bottom: 150rpx; background: #edf0f6; }
.filter-nav { position: sticky; top: 0; z-index: 20; display: grid; grid-template-columns: 90rpx minmax(0,1fr) 90rpx; align-items: center; height: 112rpx; padding: 36rpx 28rpx 0; border-bottom: 1rpx solid #eaecf2; background: #fff; }
.filter-back,.filter-reset { height: 64rpx; line-height: 64rpx; }
.filter-back { color: #4a5568; font-size: 40rpx; text-align: left; }
.filter-title { color: #17213a; font-size: 32rpx; font-weight: 700; text-align: center; }
.filter-reset { position:absolute; width:88rpx; color: #8c9bae; font-size: 28rpx; text-align: right; }
.filter-content { display: flex; flex-direction: column; gap: 30rpx; padding: 32rpx; }
.filter-card { border-radius: 30rpx; background: #fff; padding: 28rpx; box-shadow: 0 2rpx 8rpx rgba(17,32,80,.04); }
.filter-label { color: #8c9bae; font-size: 22rpx; font-weight: 600; }
.section-label { margin-bottom: 26rpx; }
.filter-field + .filter-field { margin-top: 27rpx; }
.filter-input-shell { display: flex; align-items: center; gap: 16rpx; height: 94rpx; margin-top: 12rpx; border-radius: 34rpx; background: #f3f5f9; padding: 0 28rpx; color: #a8b7cb; font-size: 28rpx; }
.filter-input { flex: 1; height: 94rpx; color: #17213a; font-size: 27rpx; }
.segmented { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14rpx; margin-top: 24rpx; }
.status-option { height: 78rpx; border-radius: 34rpx; background: #f3f5f9; color: #4a5568; font-size: 27rpx; font-weight: 700; }
.segmented .active { background: #1d50bf; color: #fff; }
.filter-bottom { position: fixed; right: 0; bottom: 0; left: 0; z-index: 30; padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; }
.filter-bottom .primary-button { width: 100%; }
