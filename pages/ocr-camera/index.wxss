.camera-page { min-height:100vh; padding:0; background:#edf0f6; }.camera-panel{min-height:650rpx;background:#0d1629;color:#fff;padding-bottom:58rpx}.camera-nav{position:relative;display:flex;align-items:center;height:112rpx;padding:36rpx 32rpx 0;font-size:31rpx;font-weight:700}.camera-close{display:flex;align-items:center;justify-content:center;flex:none;width:72rpx;min-width:72rpx;max-width:72rpx;height:72rpx;min-height:72rpx;max-height:72rpx;border-radius:50%;padding:0;background:#202b41;color:#d7deea;font-size:42rpx;line-height:72rpx}.camera-nav-title{position:absolute;right:120rpx;left:120rpx;color:#fff;text-align:center;white-space:nowrap}.camera-content{padding:24rpx 32rpx 0}.capture-card{height:640rpx;overflow:hidden;border-radius:30rpx;background:#1c2946}.camera-image{width:100%;height:100%}.camera-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:#9dabc1;font-size:26rpx;line-height:42rpx}.camera-icon{display:flex;align-items:center;justify-content:center;width:160rpx;height:160rpx;margin-bottom:32rpx;border-radius:48rpx;background:#2c3957;color:#b3bed0;font-size:60rpx}.camera-title{margin-bottom:10rpx;color:#fff;font-size:34rpx;font-weight:700}.capture-tips{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));height:124rpx;margin-top:24rpx;border-radius:30rpx;background:#19243a;color:#9dabc1}.capture-tip{display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:23rpx}.tip-number{margin-bottom:7rpx;color:#75849c;font-size:19rpx}.capture-primary,.capture-skip{width:100%;height:104rpx;border-radius:30rpx;font-size:29rpx;font-weight:700}.capture-primary{margin-top:30rpx;background:#1d50bf;color:#fff;box-shadow:0 10rpx 24rpx rgba(17,67,180,.3)}.capture-skip{margin-top:20rpx;background:#1d283d;color:#aeb9ca;font-weight:500}
