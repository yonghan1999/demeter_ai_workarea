<view class="page review-page" wx:if="{{task}}">
  <app-nav title="识别结果" nav-style="{{systemLayout.navStyle || ''}}" bind:back="back" />

  <view class="summary-card card">
    <view class="summary-image">
      <image wx:if="{{task.imagePath}}" class="summary-photo" src="{{task.imagePath}}" mode="aspectFill"></image>
      <image wx:else src="/assets/icons/image.svg" mode="aspectFit" />
    </view>
    <view>
      <view class="summary-title">共识别 {{reviewBills.length}} 笔账单</view>
      <text class="summary-copy">{{task.timeText}} 拍摄 · 点击字段可校对</text>
    </view>
    <button class="review-select-all" bindtap="toggleAll">{{allText}}</button>
  </view>

  <view wx:if="{{duplicateCount > 0}}" class="duplicate-notice">发现 {{duplicateCount}} 笔疑似重复账单，请核对后再合并</view>

  <view class="review-list">
    <view wx:for="{{reviewBills}}" wx:key="id" class="review-card card {{item.expanded ? 'expanded' : ''}} {{item.borderClass}} {{item.mutedClass}}" data-id="{{item.id}}" bindtap="toggleExpanded">
      <view class="review-card-head">
        <button class="review-check-button {{item.selectedClass}}" data-id="{{item.id}}" catchtap="toggle">
          <text wx:if="{{item.selected}}">✓</text>
        </button>
        <view class="confidence {{item.confidenceClass}}">
          可信度 {{item.confidencePercent}}%
        </view>
      </view>

      <view class="edit-grid" catchtap="stopCardTap">
        <view class="edit-field wide">
          <view class="label">托运人</view>
          <input class="review-input" data-id="{{item.id}}" data-field="shipper" value="{{item.shipper}}" maxlength="60" bindinput="setField" />
        </view>
        <view class="edit-field amount">
          <view class="label">金额</view>
          <view class="review-amount-shell"><text>¥</text><input class="review-input amount-input" type="digit" data-id="{{item.id}}" data-field="amount" value="{{item.amount}}" bindinput="setField" /></view>
        </view>
        <view class="edit-field route-field">
          <view class="label">路线</view>
          <view class="route-inputs">
            <input class="review-input route-input" data-id="{{item.id}}" data-field="from" value="{{item.from}}" maxlength="30" bindinput="setField" />
            <text>→</text>
            <input class="review-input route-input" data-id="{{item.id}}" data-field="to" value="{{item.to}}" maxlength="30" bindinput="setField" />
          </view>
        </view>
      </view>

      <view class="review-meta-grid" catchtap="stopCardTap">
        <view class="edit-field vehicle-field">
          <view class="label">车型</view>
          <input class="review-input" data-id="{{item.id}}" data-field="vehicleCargo" value="{{item.vehicleCargo}}" maxlength="40" bindinput="setField" />
        </view>
        <view class="edit-field date-meta-field">
          <view class="label">日期</view>
          <picker mode="date" value="{{item.date}}" data-id="{{item.id}}" bindchange="setDate"><view class="review-input review-picker mono">{{item.date}}</view></picker>
        </view>
      </view>

      <view class="status-pair" catchtap="stopCardTap">
        <button class="review-status-button {{item.unpaidClass}}" data-id="{{item.id}}" data-status="unpaid" bindtap="setStatus"><text>未收款</text></button>
        <button class="review-status-button {{item.paidClass}}" data-id="{{item.id}}" data-status="paid" bindtap="setStatus"><text>已收款</text></button>
      </view>

      <view wx:if="{{item.expanded}}" class="full-review-grid" catchtap="stopCardTap">
        <view class="edit-field wide">
          <view class="label">单号</view>
          <input class="review-input mono" data-id="{{item.id}}" data-field="code" value="{{item.code}}" maxlength="30" bindinput="setField" />
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-bar review-bottom">
    <view class="merge-meta">
      <text>已选 {{selectedIds.length}} 笔</text>
      <text class="merge-total">合计 {{total}}</text>
    </view>
    <button class="primary-button {{mergeDisabledClass}}" disabled="{{mergeDisabled}}" bindtap="merge">{{merging ? '正在合并…' : (hasExpanded ? '保存校对并合并 ' + selectedIds.length + ' 笔' : '合并 ' + selectedIds.length + ' 笔账单到列表')}}</button>
  </view>
</view>

<view wx:elif="{{loading}}" class="review-state"><view class="review-spinner"></view><text>正在加载识别结果</text></view>
<view wx:else class="review-state"><view>{{stateTitle}}</view><text>{{stateText}}</text><view class="review-state-actions"><button wx:if="{{loadFailed}}" bindtap="retryLoad">重新加载</button><button class="secondary" bindtap="back">返回</button></view></view>
