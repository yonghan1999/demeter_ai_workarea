.review-page { min-height:100vh; padding-bottom:190rpx; background:#edf0f6; }
.review-page .nav { display:grid; grid-template-columns:72rpx minmax(0,1fr); gap:0; background:#fff; }
.review-page .nav-title { position:absolute;bottom:18rpx;left:50%;max-width:360rpx;text-align:center;transform:translateX(-50%); }
.review-back{display:flex;align-items:center;justify-content:flex-start;width:64rpx;min-width:64rpx;max-width:64rpx;height:64rpx}.review-back image{width:48rpx;height:48rpx}
.review-toolbar { display:flex; align-items:center; justify-content:space-between; min-height:76rpx; padding:12rpx 24rpx 0; color:#8c9bae; font-size:22rpx; }
.toolbar-count { color:#17213a; font-size:28rpx; font-weight:800; }
.review-select-all { display:flex;align-items:center;justify-content:center;flex:none;height:56rpx; border-radius:22rpx; background:#fff; padding:0 24rpx; color:#1143b4; font-size:23rpx; font-weight:700; box-shadow:0 2rpx 8rpx rgba(17,32,80,.05); }
.summary-card { display:flex; align-items:center; gap:22rpx; margin:26rpx 24rpx 0; border-radius:26rpx; padding:20rpx 24rpx; }
.summary-image { display:flex; align-items:center; justify-content:center; flex:none; width:96rpx; height:96rpx; overflow:hidden; border-radius:24rpx; background:#f3f5f9; color:#bdc9d9; font-size:38rpx; }
.summary-image>image{width:54rpx;height:54rpx}.summary-image .summary-photo{width:100%;height:100%}
.summary-photo { width:100%; height:100%; }.summary-title{color:#17213a;font-size:25rpx;font-weight:800}.summary-copy{display:block;margin-top:5rpx;color:#8c9bae;font-size:19rpx}
.review-list { display:flex; flex-direction:column; gap:20rpx; padding:20rpx 24rpx 160rpx; }
.review-card { border-left:5rpx solid #e87a0a; border-radius:28rpx; padding:24rpx; }.review-card.paid-border{border-left-color:#27a550}.review-card.unpaid-border{border-left-color:#e87a0a}.review-card.muted{opacity:.5}
.review-card-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:18rpx; }
.check { display:flex; align-items:center; justify-content:center; flex:none; width:34rpx; min-width:34rpx; max-width:34rpx; height:34rpx; min-height:34rpx; max-height:34rpx; border:3rpx solid #c5cbd8; border-radius:50%; padding:0; color:#fff; font-size:20rpx; font-weight:900; line-height:34rpx; }.check.checked{border-color:#1143b4;background:#1143b4}
.confidence { border-radius:999rpx; padding:5rpx 12rpx; font-size:17rpx; font-weight:800 }.confidence.high{background:#e8f7ee;color:#1a7a38}.confidence.mid{background:#fff4ec;color:#b55800}.confidence.low{background:#fff0f0;color:#d42020}
.edit-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:16rpx 18rpx; }.edit-field .label{font-size:18rpx;letter-spacing:0}.review-input{width:100%;height:56rpx;margin-top:6rpx;border-radius:20rpx;background:#f7f8fb;padding:0 17rpx;color:#17213a;font-size:22rpx;font-weight:650}.review-amount-shell{display:flex;align-items:center;height:56rpx;margin-top:6rpx;border-radius:20rpx;background:#f7f8fb;padding-left:16rpx;color:#1143b4;font-size:20rpx}.review-amount-shell .review-input{flex:1;height:56rpx;margin:0;background:transparent;padding-left:7rpx}.amount-input{color:#1143b4;font-weight:800;text-align:right}
.date-value{display:flex;align-items:center}
.status-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin-top:20rpx}.review-status-button{height:62rpx;border-radius:28rpx;background:#f3f5f9;color:#4a5568;font-size:23rpx;font-weight:800}.status-pair .active.unpaid{background:#ef7900;color:#fff}.status-pair .active.paid{background:#1d944f;color:#fff}
.review-bottom{display:flex;flex-direction:column;gap:12rpx;padding:13rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.94);box-shadow:0 -8rpx 24rpx rgba(17,32,80,.08)}.merge-meta{display:flex;justify-content:space-between;color:#8c9bae;font-size:21rpx}.merge-total{color:#64748b}.review-bottom .primary-button{width:100%;height:76rpx;border-radius:28rpx;font-size:25rpx;gap:12rpx}.review-bottom .primary-button image{width:32rpx;height:32rpx}
.review-state{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;background:#edf0f6;color:#8c9bae;font-size:24rpx;text-align:center}.review-state>view:not(.review-spinner):not(.review-state-actions){margin-bottom:10rpx;color:#17213a;font-size:31rpx;font-weight:800}.review-state-actions{display:flex;gap:16rpx;margin-top:28rpx}.review-state button{height:68rpx;border-radius:26rpx;background:#1143b4;padding:0 36rpx;color:#fff;font-size:24rpx;font-weight:700}.review-state .secondary{background:#fff;color:#3d5275}.review-spinner{width:44rpx;height:44rpx;margin-bottom:20rpx;border:5rpx solid #dce3ee;border-top-color:#1143b4;border-radius:50%;animation:review-spin .8s linear infinite}@keyframes review-spin{to{transform:rotate(360deg)}}
