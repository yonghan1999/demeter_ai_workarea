<view class="page tasks-page">
  <view class="tasks-nav" style="{{systemLayout.navStyle}}"><button class="tasks-back" bindtap="back">←</button><view class="tasks-title">识别任务</view><button class="tasks-new" style="{{systemLayout.navActionStyle}}" bindtap="newCapture">▣ 新建</button></view>
  <view class="tasks-list">
    <view wx:for="{{tasks}}" wx:key="id" class="task-card" data-id="{{item.id}}" bindtap="review">
      <view class="task-head"><view class="task-image">▧</view><view class="task-head-copy"><view class="task-status {{item.status}} {{item.mergedClass}}">⊙ {{item.statusText}}</view><view class="task-time">{{item.timeText}}</view></view></view>
      <view wx:if="{{item.isProcessing}}" class="processing"><view class="progress"><view class="progress-inner"></view></view><text>正在识别账单字段</text></view>
      <view wx:elif="{{item.isCompleted}}" class="task-result">
        <view class="result-summary"><view><view>识别到 <text class="result-count">{{item.bills.length}}</text> 笔账单</view><text class="result-total">合计 {{item.previewTotal}}</text></view><button wx:if="{{!item.merged}}" class="view-button">查看结果  ›</button></view>
        <view wx:for="{{item.previewBills}}" wx:key="id" class="preview-row"><text>{{item.shipper}}</text><view><text class="confidence {{item.confidenceClass}}">✣ 可信度{{item.confidenceLevel}} {{item.confidencePercent}}%</text><text class="preview-amount mono">{{item.amountText}}</text></view></view>
        <view wx:if="{{item.moreCount > 0}}" class="more-count">+ {{item.moreCount}} 笔更多</view>
      </view>
    </view>
  </view>
  <view class="tasks-bottom" style="{{systemLayout.bottomSafeStyle}}"><button class="primary-button" bindtap="newCapture">▣  拍照新建识别任务</button></view>
</view>
