.search-page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #edf0f6;
}

.search-nav {
  position: sticky;
  top: 0;
  z-index: 20;
  display: grid;
  grid-template-columns: 88rpx minmax(0, 1fr);
  align-items: end;
  border-bottom: 1rpx solid #e9edf4;
  background: #ffffff;
}

.back {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 64rpx;
  height: 88rpx;
}

.back image {
  width: 44rpx;
  height: 44rpx;
}

.search-title {
  position: absolute;
  bottom: 0;
  left: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 460rpx;
  height: 88rpx;
  color: #17213a;
  font-size: 34rpx;
  font-weight: 700;
  transform: translateX(-50%);
  white-space: nowrap;
}

.search-toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 164rpx;
  padding: 0 32rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
  background: #ffffff;
  padding: 0 28rpx;
}

.search-icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  height: 96rpx;
  color: #17213a;
  font-size: 26rpx;
}

.search-confirm-button {
  flex: none;
  width: 96rpx;
  min-width: 96rpx;
  max-width: 96rpx;
  height: 88rpx;
  min-height: 88rpx;
  max-height: 88rpx;
  border-radius: 24rpx;
  background: #174fc4;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 48rpx;
  height: 48rpx;
}

.search-clear-icon {
  width: 30rpx;
  height: 30rpx;
}

.search-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  color: #9aabc2;
  font-size: 22rpx;
  text-align: center;
}

.search-state-title {
  margin: 24rpx 0 12rpx;
  color: #17213a;
  font-size: 28rpx;
  font-weight: 700;
}

.search-retry {
  width: 144rpx;
  height: 64rpx;
  margin-top: 28rpx;
  border-radius: 20rpx;
  background: #174fc4;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 56rpx;
  border-radius: 50%;
  background: #174fc4;
  box-shadow: 28rpx 0 0 #7b96d4, 56rpx 0 0 #c6d2e4;
}

.history-section,
.suggestion-section,
.result-list {
  display: flex;
  flex-direction: column;
  padding: 32rpx;
}

.result-list {
  gap: 20rpx;
}

.list-title {
  height: 56rpx;
  color: #17213a;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.history-card,
.suggestion-card {
  overflow: hidden;
  margin-top: 16rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.history-item,
.suggestion-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  height: 104rpx;
  padding: 0 32rpx 0 44rpx;
  color: #17213a;
  font-size: 26rpx;
  text-align: left;
}

.suggestion-item {
  height: 104rpx;
  padding: 0 32rpx;
}

.suggestion-item + .suggestion-item {
  border-top: 1rpx solid #e9edf4;
}

.suggestion-type {
  flex: none;
  width: 90rpx;
  color: #8da0ba;
  font-size: 22rpx;
}

.suggestion-text {
  flex: 1;
  overflow: hidden;
  color: #17213a;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-item + .history-item::before {
  position: absolute;
  top: 0;
  right: 32rpx;
  left: 32rpx;
  height: 1rpx;
  background: #e9edf4;
  content: "";
}

.history-icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
}

.clear-button {
  align-self: center;
  width: 246rpx;
  min-width: 246rpx;
  max-width: 246rpx;
  height: 88rpx;
  margin-top: 40rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: #3d5275;
  font-size: 24rpx;
  font-weight: 500;
}

.empty {
  padding-top: 180rpx;
  color: #9aabc2;
  font-size: 26rpx;
  text-align: center;
}

.empty-title {
  margin-bottom: 12rpx;
  color: #17213a;
  font-size: 32rpx;
  font-weight: 700;
}
