.search-nav {
  position: sticky;
  top: 0;
  z-index: 20;
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr);
  align-items: center;
  height: 112rpx;
  padding: 36rpx 32rpx 0;
  border-bottom: 1rpx solid #eaecf2;
  background: rgba(248, 249, 251, 0.96);
}

.back {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex: none;
  width: 56rpx;
  min-width: 56rpx;
  max-width: 56rpx;
  height: 56rpx;
  color: #002046;
}
.back image { width: 48rpx; height: 48rpx; }

.search-title {
  position: absolute;
  bottom: 18rpx;
  left: 50%;
  max-width: 360rpx;
  overflow: hidden;
  color: #17213a;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  text-overflow: ellipsis;
  transform: translateX(-50%);
  white-space: nowrap;
}

.search-toolbar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 32rpx 0;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  height: 80rpx;
  border-radius: 28rpx;
  background: #ffffff;
  padding: 0 24rpx;
}

.search-icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  color: #17213a;
  font-size: 28rpx;
}

.confirm {
  flex: none;
  width: 92rpx;
  min-width: 92rpx;
  max-width: 92rpx;
  height: 64rpx;
  border-radius: 24rpx;
  background: #1d50bf;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 52rpx;
  min-width: 52rpx;
  max-width: 52rpx;
  height: 52rpx;
}
.search-clear-icon { width: 32rpx; height: 32rpx; }

.search-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 72rpx 0;
  color: #8c9bae;
  font-size: 24rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #1143b4;
  box-shadow: 28rpx 0 0 #7b96d4, 56rpx 0 0 #c6d2e4;
  margin-right: 56rpx;
}

.history-section,
.result-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 40rpx 32rpx;
}

.list-title {
  color: #002046;
  font-size: 30rpx;
  font-weight: 700;
}

.history-card {
  overflow: hidden;
  border-radius: 16rpx;
  background: #ffffff;
  padding: 12rpx;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  height: 88rpx;
  border-radius: 12rpx;
  padding: 0 24rpx;
  color: #191c1e;
  font-size: 30rpx;
  text-align: left;
}

.history-icon {
  flex: none;
  width: 34rpx;
  height: 34rpx;
}

.clear-button {
  align-self: center;
  height: 72rpx;
  border: 1rpx solid rgba(196, 198, 207, 0.4);
  border-radius: 24rpx;
  padding: 0 44rpx;
  color: #74777f;
  font-size: 28rpx;
}

.empty {
  padding-top: 180rpx;
  text-align: center;
  color: #8c9bae;
  font-size: 26rpx;
}

.empty-title {
  margin-bottom: 12rpx;
  color: #17213a;
  font-size: 32rpx;
  font-weight: 800;
}
