<view class="page select-page">
  <view class="select-nav" style="{{systemLayout.navStyle}}">
    <button class="select-nav-button" bindtap="back"><image src="/assets/icons/back.svg" mode="aspectFit" /></button>
    <view class="select-nav-title">批量管理</view>
  </view>

  <view class="select-content">
    <view wx:if="{{!loading}}" class="select-toolbar">
      <view><text class="selected-count">{{selectedIds.length}}</text><text> / {{bills.length}} 笔已选</text></view>
      <view class="select-all-button" bindtap="toggleAll">{{allText}}</view>
    </view>
    <view wx:if="{{loading}}" class="select-skeleton" aria-label="正在加载账单">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="select-skeleton-card"><view class="skeleton-line wide"></view><view class="skeleton-line medium"></view><view class="skeleton-divider"></view><view class="skeleton-line short"></view></view>
    </view>
    <view wx:elif="{{loadFailed}}" class="select-empty"><view>账单加载失败</view><text>请检查网络后重试</text><button class="retry-button" bindtap="retryLoad">重新加载</button></view>
    <view wx:else class="select-list">
      <bill-card
        wx:for="{{bills}}"
        wx:key="id"
        bill="{{item}}"
        selectable
        selected="{{item.selected}}"
        bind:tapbill="toggle"
      />
    </view>
    <view wx:if="{{!loading && !loadFailed && bills.length === 0}}" class="select-empty"><view>暂无可管理账单</view><text>新增账单后可在这里批量操作</text></view>
  </view>

  <view wx:if="{{!loading && !loadFailed}}" class="bottom-bar select-bottom">
    <view>
      <view class="bottom-title">已选 {{selectedIds.length}} 笔合计</view>
      <view class="bottom-total mono">{{totalAmount}}</view>
    </view>
    <button class="delete-confirm {{deleteDisabledClass}}" disabled="{{deleteDisabled}}" bindtap="deleteSelected"><image class="trash-icon" src="/assets/icons/trash.svg" mode="aspectFit" />{{deleteText}}</button>
  </view>
</view>
